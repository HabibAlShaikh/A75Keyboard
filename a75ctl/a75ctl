        # -- actions -------------------------------------------------------
        def note(self, text: str):
            self.log.append(time.strftime("%H:%M:%S  ") + text)

        def connect_device(self, silent: bool = False):
            if self.dev:
                self.dev.close()
            self.dev = A75()
            try:
                self.dev.open()
                # Cache the key matrix before status polling so a later colour
                # write does not have to interleave matrix reads with GETs.
                try:
                    self.dev._valid_indices = self.dev.valid_key_indices()
                except Exception:
                    pass
                self.status_dot.setObjectName("StatusDotOn")
                self.status_label.setText("connected")
                self.note(f"Connected to {self.dev.path}")
                self._poll_status()
            except Exception as exc:
                self.status_dot.setObjectName("StatusDotOff")
                self.status_label.setText("disconnected")
                self.note(str(exc))
                if not silent:
                    QMessageBox.warning(self, "A75 Control", str(exc))
            self.status_dot.style().unpolish(self.status_dot)
            self.status_dot.style().polish(self.status_dot)

        def _require(self) -> A75 | None:
            if self.dev is None:
                self.connect_device(silent=True)
            return self.dev

        def _poll_status(self):
            if not self.dev:
                return
            try:
                st = self.dev.status()
            except DeviceStalled as exc:
                self.status_dot.setObjectName("StatusDotOff")
                self.status_label.setText("stalled")
                self.note(str(exc))
                self.status_dot.style().unpolish(self.status_dot)
                self.status_dot.style().polish(self.status_dot)
                return
            except Exception as exc:
                self.status_dot.setObjectName("StatusDotOff")
                self.status_label.setText("disconnected")
                self.status_dot.style().unpolish(self.status_dot)
                self.status_dot.style().polish(self.status_dot)
                self.dev = None
                return
            self.info["Firmware"].setText(f"v{st.firmware}")
            self.info["MLED firmware"].setText(f"v{st.mled}")
            self.info["Profile"].setText(str(st.profile))
            self.info["Mode"].setText(st.mode)
            self.info["Report rate"].setText(
                f"{st.report_rate} Hz" if st.report_rate else "unknown")
            self.info["Debounce"].setText(str(st.debounce))
            self.info["HID node"].setText(st.path)
            if st.report_rate and self.rate.findData(st.report_rate) >= 0:
                self.rate.setCurrentIndex(self.rate.findData(st.report_rate))
            if self.debounce.value() != st.debounce:
                self.debounce.setValue(st.debounce)

        def _rt_toggled(self, checked: bool):
            self.rt_press.setEnabled(checked)
            self.rt_lift.setEnabled(checked)

        def _preset(self, name: str):
            dev = self._require()
            if not dev:
                return
            try:
                dev.apply_preset(name)
                self.note(f"Preset applied: {name}")
                QTimer.singleShot(800, self._poll_status)
            except Exception as exc:
                self._error(exc)

        def _apply_actuation(self):
            dev = self._require()
            if not dev:
                return
            try:
                dev.set_global_magnetism(
                    self.travel.value_mm(),
                    self.lift.value_mm(),
                    rapid_trigger=self.rt.isChecked(),
                    rt_press_mm=self.rt_press.value_mm(),
                    rt_lift_mm=self.rt_lift.value_mm(),
                    deadzone_mm=self.deadzone.value_mm(),
                )
                self.note(
                    f"Applied: press {self.travel.value_mm():.2f} mm, "
                    f"lift {self.lift.value_mm():.2f} mm, "
                    f"RT {'on' if self.rt.isChecked() else 'off'}")
                QTimer.singleShot(800, self._poll_status)
            except Exception as exc:
                self._error(exc)

        def _set_rate(self):
            dev = self._require()
            if not dev:
                return
            try:
                dev.set_report_rate(self.rate.currentData())
                self.note(f"Report rate: {self.rate.currentData()} Hz")
                QTimer.singleShot(800, self._poll_status)
            except Exception as exc:
                self._error(exc)

        def _set_debounce(self):
            dev = self._require()
            if not dev:
                return
            try:
                dev.set_debounce(self.debounce.value())
                self.note(f"Debounce: {self.debounce.value()}")
            except Exception as exc:
                self._error(exc)

        def _calibrate(self):
            if QMessageBox.question(
                    self, "Calibration",
                    "Start travel calibration?\n\nDo not touch the keyboard "
                    "until calibration finishes.") != QMessageBox.Yes:
                return
            dev = self._require()
            if not dev:
                return
            try:
                dev.start_travel_calibration()
                self.note("Travel calibration started")
            except Exception as exc:
                self._error(exc)

        def _calibrate_max(self):
            if QMessageBox.question(
                    self, "Maximum calibration",
                    "Start maximum-travel calibration?") != QMessageBox.Yes:
                return
            dev = self._require()
            if not dev:
                return
            try:
                dev.start_max_calibration()
                self.note("Maximum calibration started")
            except Exception as exc:
                self._error(exc)

        def _error(self, exc: Exception):
            self.note(f"ERROR: {exc}")
            if isinstance(exc, DeviceStalled):
                QMessageBox.critical(self, "A75 Control", str(exc))
                self.status_dot.setObjectName("StatusDotOff")
                self.status_label.setText("stalled")
                self.status_dot.style().unpolish(self.status_dot)
                self.status_dot.style().polish(self.status_dot)
            else:
                QMessageBox.warning(self, "A75 Control", str(exc))

    app = QApplication(sys.argv)
    app.setApplicationName("A75 Control")
    app.setOrganizationName("a75ctl")
    win = MainWindow()
    win.show()
    return app.exec()


def main() -> int:
    if len(sys.argv) > 1:
        return run_cli(sys.argv[1:])
    return run_gui()


if __name__ == "__main__":
    raise SystemExit(main())
