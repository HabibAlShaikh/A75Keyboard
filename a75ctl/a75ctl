#!/usr/bin/env python3
"""A75 Control - a small Wootility-style utility for the VGN A75 HE keyboard."""

from __future__ import annotations

import argparse
import os
import sys
import time

from vgn_a75 import (
    A75, DeviceNotConnected, DeviceStalled, ProtocolError,
    MODE_NAMES, DEADZONE_DEFAULT_MM,
)


# ---------------------------------------------------------------------------
# CLI
# ---------------------------------------------------------------------------

def _open(args) -> A75:
    dev = A75(getattr(args, "device", None))
    dev.open()
    return dev


def cmd_status(args) -> int:
    with _open(args) as dev:
        st = dev.status()
    print(f"Device        : {st.path}")
    print(f"Firmware      : v{st.firmware}")
    print(f"MLED firmware : v{st.mled}")
    print(f"Profile       : {st.profile}")
    print(f"Mode          : {st.mode}")
    print(f"Report rate   : {st.report_rate} Hz" if st.report_rate else "Report rate   : unknown (GET unsupported)")
    print(f"Debounce      : {st.debounce}")
    print(f"LED           : mode={st.led_mode} speed={st.led_speed} "
          f"brightness={st.led_brightness} option={st.led_option}")
    print(f"Info          : {st.info}")
    return 0


def cmd_apply(args) -> int:
    with _open(args) as dev:
        dev.set_global_magnetism(
            args.travel, args.lift,
            rapid_trigger=args.rt,
            rt_press_mm=args.rt_press,
            rt_lift_mm=args.rt_lift,
            deadzone_mm=args.deadzone,
        )
    print(f"Applied: press={args.travel:.2f} mm lift={args.lift:.2f} mm "
          f"RT={'on' if args.rt else 'off'} "
          f"({args.rt_press:.2f}/{args.rt_lift:.2f} mm) "
          f"deadzone={args.deadzone:.2f} mm")
    return 0


def cmd_preset(args) -> int:
    with _open(args) as dev:
        dev.apply_preset(args.name)
    print(f"Preset applied: {args.name} (stored as a custom curve)")
    return 0


def cmd_rate(args) -> int:
    with _open(args) as dev:
        if args.hz is None:
            print(dev.get_report_rate())
        else:
            dev.set_report_rate(args.hz)
            print(f"Report rate: {args.hz} Hz")
    return 0


def cmd_debounce(args) -> int:
    with _open(args) as dev:
        if args.ms is None:
            print(dev.get_debounce())
        else:
            dev.set_debounce(args.ms)
            print(f"Debounce: {args.ms}")
    return 0


def cmd_analog(args) -> int:
    with _open(args) as dev:
        dev.set_magnetism_report(args.state == "on")
    print(f"Analog reporting: {args.state}")
    return 0


def cmd_calibrate(args) -> int:
    with _open(args) as dev:
        if args.maximum:
            dev.start_max_calibration()
            print("Maximum travel calibration started.")
        else:
            dev.start_travel_calibration()
            print("Travel calibration started - do not touch the keyboard.")
    return 0


def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(
        prog="a75ctl",
        description="Control the VGN A75 Hall-effect keyboard on Linux.",
    )
    p.add_argument("--device", help="hidraw node (default: auto-detect)")
    sub = p.add_subparsers(dest="command")

    s = sub.add_parser("status", help="show device status")
    s.set_defaults(func=cmd_status)

    s = sub.add_parser("apply", help="apply global actuation + rapid trigger")
    s.add_argument("--travel", type=float, required=True, help="actuation point in mm")
    s.add_argument("--lift", type=float, required=True, help="release point in mm")
    s.add_argument("--rt", action="store_true", help="enable rapid trigger")
    s.add_argument("--rt-press", type=float, default=0.2, help="RT press sensitivity (mm)")
    s.add_argument("--rt-lift", type=float, default=0.3, help="RT release sensitivity (mm)")
    s.add_argument("--deadzone", type=float, default=DEADZONE_DEFAULT_MM,
                   help="bottom deadzone in mm (0 disables)")
    s.set_defaults(func=cmd_apply)

    s = sub.add_parser("preset", help="apply a built-in actuation preset")
    s.add_argument("name", choices=["comfort", "sensitive", "gaming"])
    s.set_defaults(func=cmd_preset)

    s = sub.add_parser("rate", help="get/set the report rate")
    s.add_argument("hz", nargs="?", type=int, choices=[125, 250, 500, 1000])
    s.set_defaults(func=cmd_rate)

    s = sub.add_parser("debounce", help="get/set debounce")
    s.add_argument("ms", nargs="?", type=int)
    s.set_defaults(func=cmd_debounce)

    s = sub.add_parser("analog", help="enable/disable the analog value stream")
    s.add_argument("state", choices=["on", "off"])
    s.set_defaults(func=cmd_analog)

    s = sub.add_parser("calibrate", help="start travel calibration")
    s.add_argument("--maximum", action="store_true", help="maximum-travel calibration")
    s.set_defaults(func=cmd_calibrate)
    return p


def run_cli(argv: list[str]) -> int:
    parser = build_parser()
    args = parser.parse_args(argv)
    if not getattr(args, "func", None):
        parser.print_help()
        return 2
    try:
        return args.func(args)
    except DeviceNotConnected as exc:
        print(f"error: {exc}", file=sys.stderr)
        return 1
    except DeviceStalled as exc:
        print(f"error: {exc}", file=sys.stderr)
        return 1
    except (ProtocolError, OSError, ValueError) as exc:
        print(f"error: {exc}", file=sys.stderr)
        return 1


